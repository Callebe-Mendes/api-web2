{
  "name": "api-web2",
  "version": "1.0.0",
  "description": "API Web 2 - Entrega 1 (CRUDs e migrations)",
  "license": "ISC",
  "author": "callebe",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "start:watch": "concurrently \"npm run watch\" \"node --watch dist/index.js\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run build && npx typeorm migration:run -d dist/data-source.js",
    "migration:revert": "npm run build && npx typeorm migration:revert -d dist/data-source.js",
    "seed": "npm run build && node dist/seeds/run-seeds.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "concurrently": "^9.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
